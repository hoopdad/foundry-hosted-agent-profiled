# Copy this file to .env, then replace the project ID.
FOUNDRY_PROJECT_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
FOUNDRY_AGENT_NAME=foundry-hosted-agent-profiled
AZD_ENVIRONMENT_NAME=profiled-dev
FOUNDRY_AGENT_RUNTIME=python_3_14
# Optional: explicit user-auth context. The scripts otherwise resolve these
# values from the selected azd environment or cached target subscription.
FOUNDRY_AZURE_TENANT_ID=<tenant-id>
FOUNDRY_AZURE_SUBSCRIPTION_ID=<subscription-id>
# Storage probe Blob URLs. Use HTTPS URLs without SAS tokens.
FOUNDRY_INPUT_BLOB_PATH=https://<storage-account>.blob.core.windows.net/<container>/<input-file>
FOUNDRY_OUTPUT_BLOB_PATH=https://<storage-account>.blob.core.windows.net/<container>/<output-file>
# Post-run Azure Monitor collection. Use the workspace customer ID GUID, not its ARM ID.
LOG_ANALYTICS_WORKSPACE_ID=<workspace-customer-id>
# Optional: defaults to the account in FOUNDRY_INPUT_BLOB_PATH. If this
# override differs, the collector warns and still honors the override.
STORAGE_LOG_ACCOUNT_NAME=
# Optional: defaults to GetBlob.
STORAGE_LOG_OPERATION_NAME=GetBlob
# Optional: existing loopback SOCKS5 listener used by Foundry azd commands in
# the deploy, invoke, and post-run collection scripts. Leave empty when direct
# HTTPS connectivity is available.
FOUNDRY_AZD_HTTPS_PROXY=
# Optional as a group: deploy-hosted-agent.ps1 uses these values to start a
# persistent SOCKS5 listener through Azure Bastion when
# FOUNDRY_AZD_HTTPS_PROXY is set but not already listening. The deploy-owned
# listener remains available for invoke and collect until
# stop-foundry-proxy.ps1 is run. The scripts use the existing profile,
# extension, key, and known_hosts trust; they never log in, install, or accept
# a host key.
FOUNDRY_BASTION_AZURE_CONFIG_DIR=C:\path\to\isolated-azure-cli-profile
FOUNDRY_BASTION_SUBSCRIPTION_ID=<subscription-id>
FOUNDRY_BASTION_TENANT_ID=<tenant-id>
FOUNDRY_BASTION_RESOURCE_GROUP=<bastion-resource-group>
FOUNDRY_BASTION_NAME=<bastion-name>
FOUNDRY_BASTION_VM_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Compute/virtualMachines/<vm-name>
FOUNDRY_BASTION_VM_USER=azureuser
FOUNDRY_BASTION_IDENTITY_FILE=C:\path\to\ssh-private-key
FOUNDRY_BASTION_KNOWN_HOSTS_FILE=%USERPROFILE%\.ssh\known_hosts
FOUNDRY_BASTION_HOST_KEY_ALIAS=<trusted-host-alias>
FOUNDRY_BASTION_TUNNEL_PORT=2222
